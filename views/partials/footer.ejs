<footer class="site-footer">
  <div class="container">

    <div class="footer-grid">

      <div class="footer-col footer-about">
        <a href="/" class="brand">
          <%
            /*
             * The footer is ALWAYS dark (see .site-footer in site.css), so it must
             * always use the dark-background logo -- it must not follow the page
             * theme. helpers.logoFor(settings, theme) would hand it the light logo
             * whenever the page happens to be in light mode, drawing a logo made
             * for white onto a near-black footer.
             *
             * Falls back through generic -> light so a single-logo install still
             * renders something rather than nothing.
             */
            const footLogo = (settings.logoUrlDark || '').trim()
              || (settings.logoUrl || '').trim()
              || (settings.logoUrlLight || '').trim();
          %>
          <% if (footLogo) { %>
            <img class="brand-logo" src="<%= footLogo %>"
                 alt="<%= helpers.logoAltFor(settings) %>"
                 style="height:<%= settings.logoHeightPx %>px;width:auto">
          <% } else { %>
            <span class="brand-mark" aria-hidden="true">W</span>
            <span class="brand-text">
              <strong><%= settings.siteName %></strong>
              <small><%= tr('Bangladesh web studio', 'বাংলাদেশের ওয়েব স্টুডিও') %></small>
            </span>
          <% } %>
        </a>
        <p>
          <%= settings.tagline || 'We design, build and manage e-commerce websites for Bangladeshi businesses — complete with payment gateways, courier integration and ongoing maintenance.' %>
        </p>

        <div class="footer-contact">
          <% if (settings.supportPhone) { %>
            <span>Phone: <a href="tel:<%= settings.supportPhone %>"><%= settings.supportPhone %></a></span>
          <% } %>
          <% if (settings.whatsappNumber) { %>
            <span>WhatsApp: <a href="https://wa.me/<%= settings.whatsappNumber %>" target="_blank" rel="noopener">+<%= settings.whatsappNumber %></a></span>
          <% } %>
          <% if (settings.supportEmail) { %>
            <span>Email: <a href="mailto:<%= settings.supportEmail %>"><%= settings.supportEmail %></a></span>
          <% } %>
          <% if (settings.officeAddress) { %>
            <span><%= settings.officeAddress %></span>
          <% } %>
        </div>

        <div class="pay-logos">
          <span><%= t('bKash') %></span><span><%= t('Nagad') %></span><span><%= t('Rocket') %></span>
          <span><%= t('SSLCommerz') %></span><span><%= t('Bank transfer') %></span>
        </div>
      </div>

      <div class="footer-col">
        <h4><%= t('Services') %></h4>
        <ul>
          <li><a href="/services"><%= t('All services') %></a></li>
          <li><a href="/packages">Packages &amp; pricing</a></li>
          <li><a href="/order/checkout"><%= t('Order a website') %></a></li>
          <li><a href="/portfolio"><%= t('Our work') %></a></li>
          <li><a href="/services?category=ecommerce"><%= t('E-commerce builds') %></a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4><%= t('Company') %></h4>
        <ul>
          <li><a href="/about"><%= t('About us') %></a></li>
          <li><a href="/blog"><%= t('Blog') %></a></li>
          <li><a href="/contact"><%= t('Contact') %></a></li>
          <li><a href="/contact#faq">FAQ</a></li>
          <li><a href="/register"><%= t('Create an account') %></a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4><%= t('Support') %></h4>
        <ul>
          <li><a href="/login"><%= t('Sign in') %></a></li>
          <li><a href="/account/tickets"><%= t('Open a ticket') %></a></li>
          <li><a href="/account/subscriptions"><%= t('Manage subscription') %></a></li>
          <li><a href="/legal/terms">Terms &amp; conditions</a></li>
          <li><a href="/legal/privacy"><%= t('Privacy policy') %></a></li>
          <li><a href="/legal/refund"><%= t('Refund policy') %></a></li>
        </ul>
      </div>

    </div>

    <%# Payment methods actually accepted, on every public page. %>
    <%- include('./payment-logos', { heading: 'We accept', compact: true }) %>

    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> <%= settings.siteName %>. All rights reserved.</span>
      <% if (settings.footerText) { %>
        <span class="muted"><%= settings.footerText %></span>
      <% } %>

      <div class="footer-social">
        <% if (settings.facebookUrl) { %><a href="<%= settings.facebookUrl %>" target="_blank" rel="noopener"><%= t('Facebook') %></a><% } %>
        <% if (settings.youtubeUrl) { %><a href="<%= settings.youtubeUrl %>" target="_blank" rel="noopener"><%= t('YouTube') %></a><% } %>
        <% if (settings.linkedinUrl) { %><a href="<%= settings.linkedinUrl %>" target="_blank" rel="noopener"><%= t('LinkedIn') %></a><% } %>
        <a href="/api/health"><%= t('System status') %></a>
      </div>
    </div>

  </div>
</footer>
