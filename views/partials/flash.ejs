<% if (successMessages && successMessages.length) { %>
  <% successMessages.forEach(function (msg) { %>
    <div class="container"><div class="alert alert-success" role="status">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.7-9.3a1 1 0 00-1.4-1.4L9 10.6 7.7 9.3a1 1 0 10-1.4 1.4l2 2a1 1 0 001.4 0l4-4z"/></svg>
      <span><%= msg %></span><button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
    </div></div>
  <% }); %>
<% } %>

<% if (errorMessages && errorMessages.length) { %>
  <% errorMessages.forEach(function (msg) { %>
    <div class="container"><div class="alert alert-error" role="alert">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 5h2v6H9V5zm0 8h2v2H9v-2z"/></svg>
      <span><%= msg %></span><button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
    </div></div>
  <% }); %>
<% } %>

<% if (warningMessages && warningMessages.length) { %>
  <% warningMessages.forEach(function (msg) { %>
    <div class="container"><div class="alert alert-warning" role="status">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2l8 15H2L10 2zm0 5v5h0.01L10 7zm0 7v2h0.01L10 14z"/></svg>
      <span><%= msg %></span><button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
    </div></div>
  <% }); %>
<% } %>

<% if (infoMessages && infoMessages.length) { %>
  <% infoMessages.forEach(function (msg) { %>
    <div class="container"><div class="alert alert-info" role="status">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 9h2v6H9V9zm0-3h2v2H9V6z"/></svg>
      <span><%= msg %></span><button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
    </div></div>
  <% }); %>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="container"><div class="alert alert-error" role="alert">
    <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 5h2v6H9V5zm0 8h2v2H9v-2z"/></svg>
    <span><%= error %></span><button type="button" class="alert-close" aria-label="Dismiss">&times;</button>
  </div></div>
<% } %>
