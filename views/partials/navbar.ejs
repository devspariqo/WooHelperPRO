<header class="site-header" id="siteHeader">
  <div class="container header-inner">

    <a href="/" class="brand" aria-label="<%= settings.siteName %> home">
      <% if (settings.logoUrl) { %>
        <img class="brand-logo" src="<%= settings.logoUrl %>"
             alt="<%= settings.logoAlt || settings.siteName %>"
             style="height:<%= settings.logoHeightPx %>px;width:auto">
      <% } else { %>
        <%# No logo configured -- fall back to the generated wordmark. %>
        <span class="brand-mark" aria-hidden="true">W</span>
        <span class="brand-text">
          <strong><%= settings.siteName %></strong>
          <small>Bangladesh web studio</small>
        </span>
      <% } %>
    </a>

    <nav class="site-nav" id="siteNav" aria-label="Main">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Home</a>
      <a href="/services" class="<%= currentPath.startsWith('/services') ? 'active' : '' %>">Services</a>
      <a href="/packages" class="<%= currentPath.startsWith('/packages') ? 'active' : '' %>">Packages</a>
      <a href="/portfolio" class="<%= currentPath.startsWith('/portfolio') ? 'active' : '' %>">Our work</a>
      <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">Blog</a>
      <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About</a>
      <a href="/contact" class="<%= currentPath === '/contact' ? 'active' : '' %>">Contact</a>
    </nav>

    <div class="header-actions">

      <a class="lang-toggle" href="/lang/<%= lang === 'bn' ? 'en' : 'bn' %>" title="Switch language">
        <%= lang === 'bn' ? 'EN' : 'বাং' %>
      </a>

      <% if (isAuthenticated) { %>
        <a href="<%= isStaff ? '/admin' : '/account' %>" class="btn btn-ghost btn-sm">Dashboard</a>
        <form action="/logout" method="POST" class="inline-form">
          <%- csrfField %>
          <button type="submit" class="btn btn-outline btn-sm">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-ghost btn-sm">Sign in</a>
        <a href="/order/checkout" class="btn btn-primary btn-sm">Order now</a>
      <% } %>

      <button class="nav-toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>
