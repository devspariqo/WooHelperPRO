<nav class="muted mb-3">
  <a href="/admin/services">Services</a> <span>/</span>
  <span><%= service.title %></span>
</nav>

<section class="detail-head">
  <div class="ident">
    <h1><%= service.title %></h1>
    <p class="meta-line muted mb-0">
      <span class="badge badge-<%= service.status === 'ACTIVE' ? 'success' : (service.status === 'DRAFT' ? 'warn' : 'muted') %>">
        <%= service.status.charAt(0) + service.status.slice(1).toLowerCase() %>
      </span>
      <% if (service.isFeatured) { %><span class="badge badge-info">Featured</span><% } %>
      <span>&middot;</span>
      <span><%= service.category ? service.category.name : 'No category' %></span>
      <span>&middot;</span>
      <span><%= fmt.bdt(service.basePrice) %> starting</span>
    </p>
  </div>
  <div class="actions">
    <a class="btn btn-outline" href="/admin/services/<%= service.id %>/edit">Edit</a>
    <a class="btn btn-primary" href="/admin/packages/new?serviceId=<%= service.id %>">Add package</a>
    <a class="btn btn-ghost" href="/services/<%= service.slug %>" target="_blank" rel="noopener">View live ↗</a>
  </div>
</section>

<div class="dash-grid cols-2 mt-4" style="align-items:start">
  <div>
    <div class="card">
      <div class="card-header"><h3 class="mt-0 mb-0">Description</h3></div>
      <div class="card-body">
        <p class="muted"><%= service.shortDesc %></p>
        <div class="prose"><p><%= service.description %></p></div>

        <% if (service.shortDescBn) { %>
          <h4 class="mt-3">বাংলা</h4>
          <p class="muted"><%= service.shortDescBn %></p>
        <% } %>
        <% if (service.descriptionBn) { %>
          <div class="prose"><p><%= service.descriptionBn %></p></div>
        <% } %>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header"><h3 class="mt-0 mb-0">Included features</h3></div>
      <div class="card-body">
        <% if (!features.length) { %>
          <p class="muted mb-0">No features listed yet. Add them from the edit screen.</p>
        <% } else { %>
          <ul class="prose">
            <% features.forEach(function (f) { %><li><%= f %></li><% }); %>
          </ul>
        <% } %>

        <% if (featuresBn.length) { %>
          <h4 class="mt-3">বাংলায়</h4>
          <ul class="prose">
            <% featuresBn.forEach(function (f) { %><li><%= f %></li><% }); %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>

  <aside>
    <div class="card">
      <div class="card-header"><h3 class="mt-0 mb-0">At a glance</h3></div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item"><dt>Slug</dt><dd>/services/<%= service.slug %></dd></div>
          <div class="info-item"><dt>Icon</dt><dd><%= service.icon || '—' %></dd></div>
          <div class="info-item"><dt>Base price</dt><dd><%= fmt.bdt(service.basePrice) %></dd></div>
          <div class="info-item"><dt>Delivery</dt><dd><%= service.deliveryDays %> days</dd></div>
          <div class="info-item"><dt>Sort order</dt><dd><%= service.sortOrder %></dd></div>
          <div class="info-item"><dt>Packages</dt><dd><%= service._count.packages %></dd></div>
          <div class="info-item"><dt>Created</dt><dd><%= fmt.date(service.createdAt, 'medium') %></dd></div>
          <div class="info-item"><dt>Updated</dt><dd><%= fmt.relative(service.updatedAt) %></dd></div>
        </div>
      </div>
    </div>

    <div class="card mt-3">
      <div class="card-header">
        <div class="card-title-row">
          <h3 class="mt-0 mb-0">Packages</h3>
          <a class="sub" href="/admin/packages/new?serviceId=<%= service.id %>">Add</a>
        </div>
      </div>
      <div class="card-pad-0">
        <% if (!service.packages.length) { %>
          <div class="card-body">
            <p class="muted mb-0">
              No packages yet. A service cannot be ordered until at least one package exists.
            </p>
          </div>
        <% } else { %>
          <table class="table data">
            <thead><tr><th>Package</th><th>Status</th><th class="num">Price</th></tr></thead>
            <tbody>
              <% service.packages.forEach(function (p) { %>
                <tr>
                  <td>
                    <a class="strong" href="/admin/packages/<%= p.id %>/edit"><%= p.name %></a>
                    <br><small class="muted"><%= p.billingCycle.toLowerCase() %></small>
                  </td>
                  <td>
                    <span class="badge badge-<%= p.isActive ? 'success' : 'muted' %>">
                      <%= p.isActive ? 'Active' : 'Inactive' %>
                    </span>
                  </td>
                  <td class="num">
                    <%= p.billingCycle === 'ONE_TIME' ? fmt.bdt(p.price) : fmt.bdt(p.monthlyPrice) + '/mo' %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </aside>
</div>
