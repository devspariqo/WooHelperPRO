<%
  /*
   * Site settings singleton. `site` is the SiteSetting row (created on first
   * visit if missing). `paymentConfig`, `mailConfig` and `courierConfig` are
   * read-only environment config — shown so an operator can see which gateways
   * and SMTP are actually wired up without opening the .env file.
   */
%>

<section class="detail-head">
  <div class="ident">
    <h1>Site settings</h1>
    <p class="meta-line muted mb-0">
      Public identity, payment destinations and tax configuration. Changes take
      effect immediately across the website and every invoice.
    </p>
  </div>
</section>

<% if (site.maintenanceMode) { %>
  <div class="alert alert-warning mt-4">
    <strong>Maintenance mode is on.</strong>
    The public website is not serving customers. Turn this off once you are finished.
  </div>
<% } %>

<%
  /*
   * Settings tabs.
   *
   * Cards carry data-tab; this nav switches which ones are visible. Two things
   * matter for correctness:
   *
   *  1. Hidden panels stay IN the form. `display: none` inputs still submit --
   *     only `disabled` ones do not -- so switching tabs never drops a field from
   *     the POST. That is why the panels are hidden with CSS rather than removed.
   *  2. Without JS every panel is visible and stacked, so the page degrades to
   *     the old long-form layout instead of showing nothing. The `.js` class is
   *     added by the script below, and only `.js` hides inactive panels.
   */
  const TABS = [
    { id: 'general',  label: 'General',  hint: 'Identity, contact and availability' },
    { id: 'branding', label: 'Branding', hint: 'Logo, colours and fonts' },
    { id: 'payments', label: 'Payments', hint: 'Destinations and method logos' },
    { id: 'seo',      label: 'SEO',      hint: 'Meta defaults, sitemap and robots' },
    { id: 'email',    label: 'Email',    hint: 'SMTP and notifications' },
  ];
%>

<nav class="settings-tabs" role="tablist" aria-label="Settings sections">
  <% TABS.forEach(function (t, i) { %>
    <button type="button" role="tab" class="settings-tab<%= i === 0 ? ' is-active' : '' %>"
            data-tab-target="<%= t.id %>" aria-controls="panel-<%= t.id %>"
            aria-selected="<%= i === 0 ? 'true' : 'false' %>">
      <span class="tab-label"><%= t.label %></span>
      <span class="tab-hint"><%= t.hint %></span>
    </button>
  <% }); %>
</nav>

<form method="post" action="/admin/settings" class="mt-4 settings-form">
  <%- csrfField %>

  <div class="dash-grid cols-2">
    <div class="card" data-tab="general">
      <div class="card-header"><h3 class="mt-0 mb-0">Brand &amp; contact</h3></div>
      <div class="card-body">
        <div class="form-grid two">
          <div class="field">
            <label for="siteName">Site name <span class="req">*</span></label>
            <input type="text" id="siteName" name="siteName" required maxlength="80"
                   value="<%= site.siteName %>">
          </div>
          <div class="field">
            <label for="supportEmail">Support email</label>
            <input type="email" id="supportEmail" name="supportEmail" maxlength="160"
                   value="<%= site.supportEmail %>">
          </div>
          <div class="field full">
            <label for="tagline">Tagline (English)</label>
            <input type="text" id="tagline" name="tagline" maxlength="200"
                   value="<%= site.tagline %>"
                   placeholder="Bangladesh's ecommerce website specialists">
          </div>
          <div class="field full">
            <label for="taglineBn">Tagline (Bangla)</label>
            <input type="text" id="taglineBn" name="taglineBn" maxlength="200"
                   value="<%= site.taglineBn %>">
          </div>
          <div class="field">
            <label for="supportPhone">Support phone</label>
            <input type="tel" id="supportPhone" name="supportPhone" maxlength="24"
                   value="<%= site.supportPhone %>" placeholder="+8801700000000">
          </div>
          <div class="field">
            <label for="whatsappNumber">WhatsApp number</label>
            <input type="tel" id="whatsappNumber" name="whatsappNumber" maxlength="20"
                   value="<%= site.whatsappNumber %>" placeholder="8801700000000">
            <span class="hint">Digits only, with country code. Powers the floating WhatsApp button.</span>
          </div>
          <div class="field full">
            <label for="officeAddress">Office address</label>
            <textarea id="officeAddress" name="officeAddress" rows="2"
                      maxlength="400"><%= site.officeAddress %></textarea>
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="branding">
      <div class="card-header">
        <h3 class="mt-0 mb-0">Logo &amp; favicon</h3>
      </div>
      <div class="card-body">
        <div class="alert alert-info mb-3">
          Give a path under <code>/uploads/</code> or <code>/images/</code>, or a full https:// URL.
          Upload files in the <a href="/admin/media">media library</a> and paste the URL here.
          Leave the logo blank to keep the built-in text wordmark.
        </div>
        <div class="form-grid two">
          <div class="field full">
            <label for="logoUrl">Logo URL</label>
            <input type="text" id="logoUrl" name="logoUrl" maxlength="300"
                   value="<%= site.logoUrl %>" placeholder="/images/logo.svg">
          </div>
          <div class="field">
            <label for="logoAlt">Logo alt text</label>
            <input type="text" id="logoAlt" name="logoAlt" maxlength="120"
                   value="<%= site.logoAlt %>" placeholder="WooHelperPro">
            <span class="hint">Read aloud by screen readers. Defaults to the site name.</span>
          </div>
          <div class="field">
            <label for="logoHeightPx">Logo height (px)</label>
            <input type="number" id="logoHeightPx" name="logoHeightPx" min="16" max="96" step="1"
                   value="<%= site.logoHeightPx %>">
          </div>
          <div class="field full">
            <label for="faviconUrl">Favicon URL</label>
            <input type="text" id="faviconUrl" name="faviconUrl" maxlength="300"
                   value="<%= site.faviconUrl %>" placeholder="/images/favicon.svg">
            <span class="hint">Shown in the browser tab and in search results.</span>
          </div>
        </div>

        <h4 class="mt-4">Theme-specific logos</h4>
        <p class="hint mb-2">
          A logo drawn for a white background usually disappears on a dark one, so you can supply
          one for each. Both fall back to the logo above, so uploading a single logo still works
          in both themes.
        </p>
        <div class="form-grid two">
          <div class="field">
            <label for="logoUrlLight">Logo for light mode</label>
            <input type="text" id="logoUrlLight" name="logoUrlLight" maxlength="300"
                   value="<%= site.logoUrlLight %>" placeholder="Leave blank to use the logo above">
            <div class="logo-preview-box light-box">
              <% if (site.logoUrlLight || site.logoUrl) { %>
                <img src="<%= site.logoUrlLight || site.logoUrl %>" alt=""
                     style="height:<%= site.logoHeightPx %>px;max-width:100%">
              <% } else { %><span class="hint">No logo</span><% } %>
            </div>
          </div>
          <div class="field">
            <label for="logoUrlDark">Logo for dark mode</label>
            <input type="text" id="logoUrlDark" name="logoUrlDark" maxlength="300"
                   value="<%= site.logoUrlDark %>" placeholder="Leave blank to use the logo above">
            <div class="logo-preview-box dark-box">
              <% if (site.logoUrlDark || site.logoUrl) { %>
                <img src="<%= site.logoUrlDark || site.logoUrl %>" alt=""
                     style="height:<%= site.logoHeightPx %>px;max-width:100%">
              <% } else { %><span class="hint">No logo</span><% } %>
            </div>
          </div>
        </div>

        <h4 class="mt-4">Homepage hero image</h4>
        <p class="hint mb-2">
          A <strong>square (1:1)</strong> image shown on the right of the homepage hero. Around
          1000&times;1000px looks sharp on retina screens. Leave blank to keep the built-in
          browser mockup.
        </p>
        <div class="form-grid two">
          <div class="field">
            <label for="heroImageUrl">Hero image URL</label>
            <input type="text" id="heroImageUrl" name="heroImageUrl" maxlength="300"
                   value="<%= site.heroImageUrl %>" placeholder="/uploads/general/hero.png">
          </div>
          <div class="field">
            <label for="heroImageAlt">Hero image alt text</label>
            <input type="text" id="heroImageAlt" name="heroImageAlt" maxlength="200"
                   value="<%= site.heroImageAlt %>" placeholder="Describe the image">
          </div>
          <% if (site.heroImageUrl) { %>
            <div class="field full">
              <span class="hint">Preview — the frame below is forced to 1:1, which is how the hero renders it.</span>
              <div class="hero-preview">
                <img src="<%= site.heroImageUrl %>" alt="">
              </div>
            </div>
          <% } %>
        </div>

        <% if (site.logoUrl || site.logoUrlLight || site.logoUrlDark) { %>
          <div class="mt-3">
            <span class="hint">Preview (as the active theme resolves it)</span>
            <div class="mt-1" style="padding:12px;border:1px solid var(--border);border-radius:8px">
              <img src="<%= helpers.logoFor(site, theme) %>" alt="<%= helpers.logoAltFor(site) %>"
                   style="height:<%= site.logoHeightPx %>px;max-width:100%">
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <div class="card" data-tab="branding">
      <div class="card-header">
        <h3 class="mt-0 mb-0">Colours &amp; fonts</h3>
      </div>
      <div class="card-body">
        <div class="alert alert-info mb-3">
          Applied across the public site and the dashboards as CSS variables, so changes
          show up on the next page load with no rebuild.
        </div>
        <div class="form-grid three">
          <div class="field">
            <label for="primaryColor">Primary colour</label>
            <div class="color-row">
              <input type="color" id="primaryColorPicker"
                     value="<%= site.primaryColor %>"
                     oninput="document.getElementById('primaryColor').value=this.value">
              <input type="text" id="primaryColor" name="primaryColor" maxlength="7"
                     pattern="#[0-9A-Fa-f]{3,6}" value="<%= site.primaryColor %>"
                     oninput="document.getElementById('primaryColorPicker').value=this.value">
            </div>
          </div>
          <div class="field">
            <label for="secondaryColor">Secondary colour</label>
            <div class="color-row">
              <input type="color" id="secondaryColorPicker"
                     value="<%= site.secondaryColor %>"
                     oninput="document.getElementById('secondaryColor').value=this.value">
              <input type="text" id="secondaryColor" name="secondaryColor" maxlength="7"
                     pattern="#[0-9A-Fa-f]{3,6}" value="<%= site.secondaryColor %>"
                     oninput="document.getElementById('secondaryColorPicker').value=this.value">
            </div>
          </div>
          <div class="field">
            <label for="accentColor">Accent colour</label>
            <div class="color-row">
              <input type="color" id="accentColorPicker"
                     value="<%= site.accentColor %>"
                     oninput="document.getElementById('accentColor').value=this.value">
              <input type="text" id="accentColor" name="accentColor" maxlength="7"
                     pattern="#[0-9A-Fa-f]{3,6}" value="<%= site.accentColor %>"
                     oninput="document.getElementById('accentColorPicker').value=this.value">
            </div>
          </div>
        </div>

        <div class="form-grid two mt-3">
          <div class="field">
            <label for="fontHeading">Heading font (English)</label>
            <input type="text" id="fontHeading" name="fontHeading" maxlength="60"
                   value="<%= site.fontHeading %>" placeholder="Inter">
          </div>
          <div class="field">
            <label for="fontBody">Body font (English)</label>
            <input type="text" id="fontBody" name="fontBody" maxlength="60"
                   value="<%= site.fontBody %>" placeholder="Inter">
          </div>
          <div class="field">
            <label for="fontHeadingBn">Heading font (Bangla)</label>
            <input type="text" id="fontHeadingBn" name="fontHeadingBn" maxlength="60"
                   value="<%= site.fontHeadingBn %>" placeholder="Hind Siliguri">
          </div>
          <div class="field">
            <label for="fontBodyBn">Body font (Bangla)</label>
            <input type="text" id="fontBodyBn" name="fontBodyBn" maxlength="60"
                   value="<%= site.fontBodyBn %>" placeholder="Hind Siliguri">
          </div>
        </div>
        <span class="hint">
          Google Fonts family names. The stylesheet link is built from these values, so any
          family Google serves will work.
        </span>
      </div>
    </div>

    <div class="card" data-tab="payments">
      <div class="card-header"><h3 class="mt-0 mb-0">Payment destinations</h3></div>
      <div class="card-body">
        <div class="alert alert-info mb-3">
          These numbers are shown to customers on the checkout and invoice pages when
          they choose a manual mobile-wallet transfer. Every transfer is verified by
          hand, so they must be the accounts you actually monitor.
        </div>
        <div class="form-grid two">
          <div class="field">
            <label for="bkashNumber">bKash merchant number</label>
            <input type="text" id="bkashNumber" name="bkashNumber" maxlength="20"
                   value="<%= site.bkashNumber %>" placeholder="01XXXXXXXXX">
          </div>
          <div class="field">
            <label for="nagadNumber">Nagad number</label>
            <input type="text" id="nagadNumber" name="nagadNumber" maxlength="20"
                   value="<%= site.nagadNumber %>">
          </div>
          <div class="field">
            <label for="rocketNumber">Rocket number</label>
            <input type="text" id="rocketNumber" name="rocketNumber" maxlength="24"
                   value="<%= site.rocketNumber %>">
          </div>
          <div class="field">
            <label for="vatPercent">VAT rate (%)</label>
            <input type="number" id="vatPercent" name="vatPercent" step="0.5" min="0" max="30"
                   value="<%= site.vatPercent %>">
            <span class="hint">
              5% is the common services rate in Bangladesh. Applied to every order,
              invoice and renewal.
            </span>
          </div>
          <div class="field full">
            <label for="bankDetails">Bank transfer details</label>
            <textarea id="bankDetails" name="bankDetails" rows="3" maxlength="600"
                      placeholder="Account name, bank, branch, account number, routing number."><%= site.bankDetails %></textarea>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="dash-grid cols-3 mt-4">
    <div class="card" data-tab="payments">
      <div class="card-header"><h3 class="mt-0 mb-0">Payment method logos</h3></div>
      <div class="card-body">
        <div class="alert alert-info mb-3">
          Shown on the checkout, package pages and the public footer so a customer can see which
          rails you accept before they pay. Upload a file in the
          <a href="/admin/media">media library</a>, then paste its URL here. Leave one blank and
          that method simply is not advertised.
        </div>
        <div class="form-grid two">
          <% [
               ['bkashLogoUrl', 'bKash logo'],
               ['nagadLogoUrl', 'Nagad logo'],
               ['rocketLogoUrl', 'Rocket logo'],
               ['sslcommerzLogoUrl', 'SSLCommerz logo'],
               ['bankLogoUrl', 'Bank transfer logo'],
               ['codLogoUrl', 'Cash on delivery logo'],
               ['cardLogoUrl', 'Card / Visa-Mastercard logo'],
             ].forEach(function (pair) { %>
            <div class="field">
              <label for="<%= pair[0] %>"><%= pair[1] %></label>
              <div class="logo-field">
                <input type="text" id="<%= pair[0] %>" name="<%= pair[0] %>" maxlength="300"
                       value="<%= site[pair[0]] %>" placeholder="/uploads/payments/bkash.png">
                <% if (site[pair[0]]) { %>
                  <img src="<%= site[pair[0]] %>" alt="" class="logo-preview" loading="lazy">
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <div class="card" data-tab="seo">
      <div class="card-header"><h3 class="mt-0 mb-0">Search engine defaults</h3></div>
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label for="metaTitle">Default meta title</label>
            <input type="text" id="metaTitle" name="metaTitle" maxlength="160"
                   value="<%= site.metaTitle %>">
            <span class="hint">Aim for 50–60 characters.</span>
          </div>
          <div class="field">
            <label for="metaDescription">Default meta description</label>
            <textarea id="metaDescription" name="metaDescription" rows="3"
                      maxlength="320"><%= site.metaDescription %></textarea>
            <span class="hint">Aim for 150–160 characters.</span>
          </div>
          <div class="field">
            <label for="metaKeywords">Keywords</label>
            <input type="text" id="metaKeywords" name="metaKeywords" maxlength="300"
                   value="<%= site.metaKeywords %>"
                   placeholder="ecommerce website design bangladesh, online shop builder">
            <span class="hint">Comma separated. Ignored by Google, still read by some engines.</span>
          </div>
          <div class="field">
            <label for="metaRobots">Robots directive</label>
            <select id="metaRobots" name="metaRobots">
              <% ['index, follow', 'noindex, follow', 'index, nofollow', 'noindex, nofollow']
                   .forEach(function (opt) { %>
                <option value="<%= opt %>" <%= site.metaRobots === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
            <span class="hint">Set to noindex while the site is still being built.</span>
          </div>
          <div class="field">
            <label for="ogImageUrl">Social share image</label>
            <input type="text" id="ogImageUrl" name="ogImageUrl" maxlength="300"
                   value="<%= site.ogImageUrl %>" placeholder="/images/og-cover.png">
            <span class="hint">Shown when a link is shared on Facebook or WhatsApp. 1200×630 works best.</span>
          </div>
          <div class="field">
            <label for="twitterHandle">X / Twitter handle</label>
            <input type="text" id="twitterHandle" name="twitterHandle" maxlength="40"
                   value="<%= site.twitterHandle %>" placeholder="woohelperpro">
          </div>
          <div class="field">
            <label for="googleAnalyticsId">Google Analytics ID</label>
            <input type="text" id="googleAnalyticsId" name="googleAnalyticsId" maxlength="30"
                   value="<%= site.googleAnalyticsId %>" placeholder="G-XXXXXXXXXX">
            <span class="hint">Leave blank to load no analytics at all.</span>
          </div>
          <div class="field">
            <label for="googleSiteVerification">Search Console verification</label>
            <input type="text" id="googleSiteVerification" name="googleSiteVerification" maxlength="120"
                   value="<%= site.googleSiteVerification %>">
            <span class="hint">The <code>content</code> value of the verification meta tag.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="general">
      <div class="card-header"><h3 class="mt-0 mb-0">General</h3></div>
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label for="timezone">Timezone</label>
            <input type="text" id="timezone" name="timezone" maxlength="60"
                   value="<%= site.timezone %>" placeholder="Asia/Dhaka">
            <span class="hint">Used for date display and the billing sweep cut-off.</span>
          </div>
          <div class="field">
            <label for="defaultLanguage">Default language</label>
            <select id="defaultLanguage" name="defaultLanguage">
              <option value="en" <%= site.defaultLanguage === 'en' ? 'selected' : '' %>>English</option>
              <option value="bn" <%= site.defaultLanguage === 'bn' ? 'selected' : '' %>>বাংলা (Bangla)</option>
            </select>
          </div>
          <div class="field">
            <label for="dateFormat">Date format</label>
            <select id="dateFormat" name="dateFormat">
              <% ['DD MMM YYYY', 'DD/MM/YYYY', 'YYYY-MM-DD', 'MMM DD, YYYY']
                   .forEach(function (opt) { %>
                <option value="<%= opt %>" <%= site.dateFormat === opt ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label for="footerText">Footer text</label>
            <input type="text" id="footerText" name="footerText" maxlength="200"
                   value="<%= site.footerText %>"
                   placeholder="Built in Dhaka for Bangladeshi businesses">
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="general">
      <div class="card-header"><h3 class="mt-0 mb-0">Social profiles</h3></div>
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label for="facebookUrl">Facebook page</label>
            <input type="url" id="facebookUrl" name="facebookUrl" maxlength="250"
                   value="<%= site.facebookUrl %>">
          </div>
          <div class="field">
            <label for="youtubeUrl">YouTube channel</label>
            <input type="url" id="youtubeUrl" name="youtubeUrl" maxlength="250"
                   value="<%= site.youtubeUrl %>">
          </div>
          <div class="field">
            <label for="linkedinUrl">LinkedIn page</label>
            <input type="url" id="linkedinUrl" name="linkedinUrl" maxlength="250"
                   value="<%= site.linkedinUrl %>">
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="email">
      <div class="card-header"><h3 class="mt-0 mb-0">Email delivery (SMTP)</h3></div>
      <div class="card-body">
        <div class="alert alert-info mb-3">
          Used for order, payment and support notifications. Leave the host blank to fall back to
          the <code>SMTP_*</code> environment variables. When nothing is configured, messages are
          written to the server log instead of being sent — useful in development.
        </div>
        <div class="form-grid two">
          <div class="field">
            <label for="smtpHost">SMTP host</label>
            <input type="text" id="smtpHost" name="smtpHost" maxlength="160"
                   value="<%= site.smtpHost %>" placeholder="smtp.hostinger.com">
          </div>
          <div class="field">
            <label for="smtpPort">Port</label>
            <input type="number" id="smtpPort" name="smtpPort" min="1" max="65535"
                   value="<%= site.smtpPort %>">
            <span class="hint">465 for implicit TLS, 587 for STARTTLS.</span>
          </div>
          <div class="field">
            <label for="smtpUser">Username</label>
            <input type="text" id="smtpUser" name="smtpUser" maxlength="160"
                   value="<%= site.smtpUser %>" autocomplete="off">
          </div>
          <div class="field">
            <label for="smtpPassword">Password</label>
            <input type="password" id="smtpPassword" name="smtpPassword" maxlength="200"
                   autocomplete="new-password"
                   placeholder="<%= site.smtpPassword ? '•••••••• (saved)' : 'Not set' %>">
            <span class="hint">Leave blank to keep the saved password.</span>
          </div>
          <div class="field">
            <label for="mailFromName">From name</label>
            <input type="text" id="mailFromName" name="mailFromName" maxlength="120"
                   value="<%= site.mailFromName %>" placeholder="<%= site.siteName %>">
          </div>
          <div class="field">
            <label for="mailFromEmail">From address</label>
            <input type="email" id="mailFromEmail" name="mailFromEmail" maxlength="160"
                   value="<%= site.mailFromEmail %>" placeholder="no-reply@example.com">
          </div>
          <div class="field">
            <label for="adminNotificationEmail">Admin notification address</label>
            <input type="email" id="adminNotificationEmail" name="adminNotificationEmail" maxlength="160"
                   value="<%= site.adminNotificationEmail %>">
            <span class="hint">Where internal alerts go. Falls back to the support email.</span>
          </div>
          <div class="field">
            <label for="smtpSecure">Encryption</label>
            <label class="check-row" for="smtpSecure">
              <input type="checkbox" id="smtpSecure" name="smtpSecure"
                     <%= site.smtpSecure ? 'checked' : '' %>>
              <span>Use implicit TLS (usually port 465)</span>
            </label>
          </div>
        </div>

        <h4 class="mt-4">Which notifications to send</h4>
        <div class="form-grid two">
          <div class="field">
            <label>To the team</label>
            <label class="check-row" for="notifyAdminOnOrder">
              <input type="checkbox" id="notifyAdminOnOrder" name="notifyAdminOnOrder"
                     <%= site.notifyAdminOnOrder ? 'checked' : '' %>>
              <span>New order placed</span>
            </label>
            <label class="check-row" for="notifyAdminOnPayment">
              <input type="checkbox" id="notifyAdminOnPayment" name="notifyAdminOnPayment"
                     <%= site.notifyAdminOnPayment ? 'checked' : '' %>>
              <span>Payment awaiting verification</span>
            </label>
            <label class="check-row" for="notifyAdminOnTicket">
              <input type="checkbox" id="notifyAdminOnTicket" name="notifyAdminOnTicket"
                     <%= site.notifyAdminOnTicket ? 'checked' : '' %>>
              <span>New support ticket</span>
            </label>
            <label class="check-row" for="notifyAdminOnLead">
              <input type="checkbox" id="notifyAdminOnLead" name="notifyAdminOnLead"
                     <%= site.notifyAdminOnLead ? 'checked' : '' %>>
              <span>New enquiry from the contact form</span>
            </label>
          </div>
          <div class="field">
            <label>To the customer</label>
            <label class="check-row" for="notifyCustomerOnOrder">
              <input type="checkbox" id="notifyCustomerOnOrder" name="notifyCustomerOnOrder"
                     <%= site.notifyCustomerOnOrder ? 'checked' : '' %>>
              <span>Order received and status changes</span>
            </label>
            <label class="check-row" for="notifyCustomerOnPayment">
              <input type="checkbox" id="notifyCustomerOnPayment" name="notifyCustomerOnPayment"
                     <%= site.notifyCustomerOnPayment ? 'checked' : '' %>>
              <span>Payment confirmed</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="seo">
      <div class="card-header"><h3 class="mt-0 mb-0">Search engines &amp; crawling</h3></div>
      <div class="card-body">
        <div class="form-grid">
          <div class="field">
            <label class="check-row" for="sitemapEnabled">
              <input type="checkbox" id="sitemapEnabled" name="sitemapEnabled"
                     <%= site.sitemapEnabled ? 'checked' : '' %>>
              <span>Serve a generated <code>/sitemap.xml</code></span>
            </label>
            <span class="hint">
              Built automatically from your published services, packages, blog posts and portfolio
              items. Changes as soon as you publish something.
            </span>
          </div>
          <div class="field">
            <label for="robotsExtraDisallow">Extra paths to disallow</label>
            <textarea id="robotsExtraDisallow" name="robotsExtraDisallow" rows="3"
                      maxlength="1000"
                      placeholder="/preview&#10;/internal"><%= site.robotsExtraDisallow %></textarea>
            <span class="hint">One path per line. Account and admin areas are always excluded.</span>
          </div>
          <div class="field">
            <label for="robotsTxt">Custom robots.txt</label>
            <textarea id="robotsTxt" name="robotsTxt" rows="6" maxlength="4000"
                      placeholder="Leave blank to use the generated file"><%= site.robotsTxt %></textarea>
            <span class="hint">
              If you fill this in it replaces the generated <code>robots.txt</code> entirely —
              you then own the sitemap reference too.
            </span>
          </div>
        </div>
      </div>
    </div>

    <div class="card" data-tab="general">
      <div class="card-header"><h3 class="mt-0 mb-0">Availability</h3></div>
      <div class="card-body">
        <label class="check-row" for="maintenanceMode">
          <input type="checkbox" id="maintenanceMode" name="maintenanceMode"
                 <%= site.maintenanceMode ? 'checked' : '' %>>
          <span>
            <strong>Maintenance mode</strong><br>
            <small class="muted">Takes the public website offline. The admin panel stays reachable.</small>
          </span>
        </label>

        <hr>
        <p class="hint muted mb-0">
          Last saved <%= fmt.datetime(site.updatedAt) %>.
        </p>
      </div>
    </div>
  </div>

  <div class="card mt-4">
    <div class="card-body form-actions">
      <button type="submit" class="btn btn-primary">Save settings</button>
      <a class="btn btn-outline" href="/admin">Cancel</a>
    </div>
  </div>
</form>

<%#
  Separate form on purpose: the test-mail action must not be a nested <form>, and it
  must NOT submit the settings form — testing the transport should be possible while
  the SMTP fields are still unsaved-and-then-saved in a deliberate order.
%>
<form method="post" action="/admin/settings/test-mail" class="card mt-4">
  <%- csrfField %>
  <div class="card-header"><h3 class="mt-0 mb-0">Send a test email</h3></div>
  <div class="card-body">
    <p class="muted">
      Sends one message using the settings <strong>as currently saved</strong>. Save your SMTP
      changes first, then test.
    </p>
    <div class="form-grid two">
      <div class="field">
        <label for="testTo">Send to</label>
        <input type="email" id="testTo" name="testTo" maxlength="160"
               value="<%= site.adminNotificationEmail || site.supportEmail %>">
      </div>
      <div class="field">
        <label>&nbsp;</label>
        <button class="btn btn-outline" type="submit">Send test email</button>
      </div>
    </div>
  </div>
</form>

<!-- ================= Read-only environment status ================= -->
<div class="dash-grid cols-3 mt-4">
  <div class="card">
    <div class="card-header">
      <div class="card-title-row">
        <h3 class="mt-0 mb-0">Payment gateways</h3>
        <span class="sub muted">from environment</span>
      </div>
    </div>
    <div class="card-body">
      <% var gateways = [
        ['bKash', paymentConfig && paymentConfig.bkash],
        ['Nagad', paymentConfig && paymentConfig.nagad],
        ['SSLCommerz', paymentConfig && paymentConfig.sslcommerz],
      ]; %>
      <ul class="summary-list">
        <% gateways.forEach(function (g) { %>
          <li>
            <span class="label"><%= g[0] %></span>
            <span class="value">
              <% var on = !!(g[1] && (g[1].enabled || g[1].storeId || g[1].merchantNumber || g[1].apiKey)); %>
              <span class="badge badge-<%= on ? 'success' : 'muted' %>">
                <%= on ? 'Configured' : 'Not configured' %>
              </span>
            </span>
          </li>
        <% }); %>
      </ul>
      <p class="hint muted mb-0">
        Unconfigured gateways fall back to manual transfer with receipt submission,
        which is the standard workflow for most Bangladeshi merchants.
      </p>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title-row">
        <h3 class="mt-0 mb-0">Email delivery</h3>
        <span class="sub muted">from environment</span>
      </div>
    </div>
    <div class="card-body">
      <% var smtpOn = !!(mailConfig && mailConfig.host); %>
      <ul class="summary-list">
        <li>
          <span class="label">SMTP host</span>
          <span class="value"><%= smtpOn ? mailConfig.host : '—' %></span>
        </li>
        <li>
          <span class="label">Status</span>
          <span class="value">
            <span class="badge badge-<%= smtpOn ? 'success' : 'warn' %>">
              <%= smtpOn ? 'Live' : 'Log only' %>
            </span>
          </span>
        </li>
      </ul>
      <% if (!smtpOn) { %>
        <div class="alert alert-warning">
          No SMTP is configured, so outbound email is written to the server log
          instead of sent. Customers will not receive invoices or status updates —
          relay anything important by phone or WhatsApp.
        </div>
      <% } else { %>
        <p class="hint muted mb-0">Transactional email is delivered over SMTP.</p>
      <% } %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div class="card-title-row">
        <h3 class="mt-0 mb-0">Courier integrations</h3>
        <span class="sub muted">from environment</span>
      </div>
    </div>
    <div class="card-body">
      <% var couriers = [
        ['Pathao', courierConfig && courierConfig.pathao],
        ['Steadfast', courierConfig && courierConfig.steadfast],
        ['RedX', courierConfig && courierConfig.redx],
      ]; %>
      <ul class="summary-list">
        <% couriers.forEach(function (c) { %>
          <li>
            <span class="label"><%= c[0] %></span>
            <span class="value">
              <span class="badge badge-<%= (c[1] && c[1].enabled) ? 'success' : 'muted' %>">
                <%= (c[1] && c[1].enabled) ? 'Enabled' : 'Off' %>
              </span>
            </span>
          </li>
        <% }); %>
      </ul>
      <p class="hint muted mb-0">
        Courier booking is handled outside this panel until credentials are added.
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.querySelector('.settings-form');
    var nav = document.querySelector('.settings-tabs');
    if (!form || !nav) return;

    var tabs = [].slice.call(nav.querySelectorAll('.settings-tab'));
    var cards = [].slice.call(form.querySelectorAll('.card[data-tab]'));
    if (!tabs.length || !cards.length) return;

    // Only now does the CSS hide inactive panels. Before this runs, everything is
    // visible, so a JS failure leaves a usable (if long) page rather than a blank one.
    document.documentElement.classList.add('js-tabs');

    function show(id, pushHash) {
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-tab-target') === id;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      cards.forEach(function (c) {
        c.classList.toggle('tab-active', c.getAttribute('data-tab') === id);
      });
      // Keep the tab in the hash so a save-and-redirect lands back on the same tab.
      if (pushHash) history.replaceState(null, '', '#' + id);
      try { sessionStorage.setItem('whp.settingsTab', id); } catch (e) { /* private mode */ }
    }

    var valid = tabs.map(function (t) { return t.getAttribute('data-tab-target'); });

    // Restore: hash first (shareable), then the remembered tab, else the first one.
    var initial = location.hash.replace('#', '');
    if (valid.indexOf(initial) === -1) {
      try { initial = sessionStorage.getItem('whp.settingsTab') || ''; } catch (e) { initial = ''; }
    }
    if (valid.indexOf(initial) === -1) initial = valid[0];
    show(initial, false);

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        show(t.getAttribute('data-tab-target'), true);
      });
      // Left/right arrows move between tabs, as expected of role="tablist".
      t.addEventListener('keydown', function (e) {
        var i = valid.indexOf(t.getAttribute('data-tab-target'));
        var next = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : -1;
        if (next < 0 || next >= valid.length) return;
        e.preventDefault();
        tabs[next].focus();
        show(valid[next], true);
      });
    });

    // If a field fails validation on a hidden tab, the browser focuses it but the
    // user sees nothing -- so surface that tab instead of silently doing nothing.
    form.addEventListener('invalid', function (e) {
      var card = e.target.closest ? e.target.closest('.card[data-tab]') : null;
      if (card) show(card.getAttribute('data-tab'), true);
    }, true);
  })();
</script>
