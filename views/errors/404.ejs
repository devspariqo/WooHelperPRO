<%
  // Rendered by `app.use()` 404 fallbacks, by account/admin routes, and by the
  // CSRF middleware -- all of which can run before loadUser, so nothing here may
  // assume a signed-in user.
  //
  // The layout is pinned to 'layouts/error' by the res.render wrapper in
  // src/middleware/csrf.js; it cannot be set from inside the template because
  // express-ejs-layouts resolves the layout before the view body runs.
%>
<section class="section">
  <div class="container container-narrow center">
    <div class="empty-state">
      <div class="empty-icon">404</div>
      <h1 class="mt-0">We could not find that page</h1>
      <p class="muted">
        The link may be broken, or the page may have been moved. If you were looking for a
        service or a package, start from one of the links below.
      </p>
      <div class="form-actions center">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline" href="/services">Browse services</a>
        <a class="btn btn-ghost" href="/packages">View packages</a>
      </div>
    </div>
  </div>
</section>
