<%
  // Rendered by the terminal error handler in src/server.js, which can be reached
  // from anywhere -- including middleware that runs before loadUser. It must
  // therefore never depend on post-loadUser locals.
  //
  // The layout is pinned to 'layouts/error' by the res.render wrapper in
  // src/middleware/csrf.js. Inheriting the public layout is what made the 403 path
  // cascade into a second 500, and the same thing happened here.
%>
<section class="section">
  <div class="container container-narrow center">
    <div class="empty-state">
      <div class="empty-icon">500</div>
      <h1 class="mt-0">Something broke on our side</h1>
      <p class="muted">
        The request reached the server but the server could not finish it. The error has been
        logged. Try again, and if it keeps happening contact us so we can look at the log.
      </p>

      <% if (typeof message !== 'undefined' && message) { %>
        <p class="muted"><code><%= message %></code></p>
      <% } %>

      <div class="form-actions center">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn btn-outline" href="/contact">Report this</a>
      </div>
    </div>
  </div>
</section>
