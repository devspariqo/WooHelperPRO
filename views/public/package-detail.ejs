<section class="section">
  <div class="container">
    <nav class="muted mb-3">
      <a href="/">Home</a> <span>/</span> <a href="/packages">Packages</a> <span>/</span>
      <span><%= package.name %></span>
    </nav>

    <div class="grid grid-2 mt-0" style="align-items:start">
      <div>
        <span class="section-kicker">
          <%= C.PACKAGE_TIER[package.tier] ? C.PACKAGE_TIER[package.tier].en : package.tier %>
        </span>
        <h1 class="mt-1"><%= package.name %></h1>
        <p class="muted"><%= package.tagline || '' %></p>

        <div class="prose">
          <p><%= package.description || '' %></p>
        </div>

        <h3>What you get</h3>
        <ul class="prose">
          <% features.forEach(function (f) { %>
            <li><%= f %></li>
          <% }); %>
        </ul>

        <% if (excluded.length) { %>
          <h3>Not included in this tier</h3>
          <ul class="prose excluded">
            <% excluded.forEach(function (f) { %>
              <li class="excluded"><%= f %></li>
            <% }); %>
          </ul>
        <% } %>
      </div>

      <aside>
        <div class="card">
          <div class="card-header">
            <h3 class="mt-0 mb-0">Pricing</h3>
          </div>
          <div class="card-body">
            <ul class="summary-list">
              <% if (package.setupFee > 0) { %>
                <li>
                  <span class="label">One-time setup fee</span>
                  <span class="value"><%= fmt.bdt(package.setupFee) %></span>
                </li>
              <% } %>
              <% if (package.monthlyPrice > 0) { %>
                <li>
                  <span class="label">Monthly</span>
                  <span class="value"><%= fmt.bdt(package.monthlyPrice) %></span>
                </li>
              <% } %>
              <% if (package.yearlyPrice > 0) { %>
                <li>
                  <span class="label">Yearly <span class="pkg-save">save 2 months</span></span>
                  <span class="value"><%= fmt.bdt(package.yearlyPrice) %></span>
                </li>
              <% } %>
              <% if (package.price > 0) { %>
                <li>
                  <span class="label">One-time purchase</span>
                  <span class="value"><%= fmt.bdt(package.price) %></span>
                </li>
              <% } %>              <% if (package.trialDays > 0) { %>
                <li>
                  <span class="label">Free trial</span>
                  <span class="value"><%= package.trialDays %> days</span>
                </li>
              <% } %>
            </ul>

            <div class="form-actions mt-3">
              <a class="btn btn-primary btn-block btn-lg"
                 href="/order/checkout?packageId=<%= package.id %>">Order this package</a>
              <a class="btn btn-outline btn-block" href="/contact?package=<%= package.slug %>">
                Ask a question first
              </a>
            </div>

            <p class="pkg-note muted mt-3 mb-0"><%= package.note || 'Cancel anytime. No lock-in contract.' %></p>
          </div>
        </div>

        <% if (package.deliveryDays) { %>
          <div class="card mt-3">
            <div class="card-body">
              <p class="mb-0">
                <strong>Typical delivery:</strong> <%= package.deliveryDays %> days from payment
                confirmation and content handover.
              </p>
            </div>
          </div>
        <% } %>
      </aside>
    </div>
  </div>
</section>
