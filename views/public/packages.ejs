<section class="section section-soft">
  <div class="container">
    <div class="section-head center">
      <p class="section-kicker">Packages</p>
      <h1 class="mt-0">A website package built for how Bangladeshi businesses actually sell</h1>
      <p class="muted">
        Every package includes hosting setup, SSL, mobile-first design, Bangla/English support and
        a real handover call. Monthly and yearly billing available on every tier.
      </p>
    </div>

    <div class="center mb-4">
      <div class="billing-toggle btn-group">
        <a class="btn <%= !billing || billing === 'MONTHLY' ? 'btn-primary' : 'btn-outline' %>" href="/packages?billing=MONTHLY">Monthly</a>
        <a class="btn <%= billing === 'YEARLY' ? 'btn-primary' : 'btn-outline' %>" href="/packages?billing=YEARLY">Yearly — save 2 months</a>
      </div>
    </div>

    <div class="grid grid-3">
      <% packages.forEach(function (pkg) { %>
        <%
          // Show the price for the cycle the visitor selected; fall back to the
          // yearly rate divided by 12 so the comparison stays honest.
          const monthly = Number(pkg.monthlyPrice || 0);
          const yearly = Number(pkg.yearlyPrice || 0);
          const showYearly = billing === 'YEARLY' && yearly > 0;
          const headline = showYearly ? yearly : (monthly || Math.round(yearly / 12));
          const perLabel = showYearly ? '/year' : '/month';
          const features = json.parse(pkg.features, []);
        %>
        <article class="pkg-card <%= pkg.isPopular ? 'popular' : '' %>">
          <% if (pkg.isPopular) { %><span class="pkg-ribbon">Most popular</span><% } %>

          <div class="pkg-head">
            <span class="pkg-tier">
              <%= C.PACKAGE_TIER[pkg.tier] ? C.PACKAGE_TIER[pkg.tier].en : pkg.tier %>
            </span>
            <h3 class="pkg-name mt-0"><%= tr(pkg.name, pkg.nameBn) %></h3>
            <p class="pkg-tagline muted"><%= tr(pkg.tagline, pkg.taglineBn) || '' %></p>
          </div>

          <div class="pkg-price">
            <strong><%= fmt.bdt(headline) %></strong>
            <span class="muted"><%= perLabel %></span>
          </div>

          <% if (!showYearly && yearly > 0) { %>
            <p class="pkg-note muted">Yearly: <strong><%= fmt.bdt(yearly) %></strong> — two months free.</p>
          <% } %>

          <ul class="pkg-features">
            <% features.slice(0, 8).forEach(function (f) { %>
              <li><%= f %></li>
            <% }); %>
          </ul>

          <div class="pkg-footer">
            <a class="btn btn-primary btn-block" href="/packages/<%= pkg.slug %>">Choose <%= pkg.name %></a>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head center">
      <h2 class="mt-0">Add a service on top of any package</h2>
      <p class="muted">Bolt on what your business needs — SEO, ads management, or extra pages.</p>
    </div>

    <div class="grid grid-3">
      <% services.slice(0, 8).forEach(function (svc) { %>
        <article class="svc-card">
          <div class="svc-icon"><%= svc.icon || '◆' %></div>
          <h4 class="mt-0"><a href="/services/<%= svc.slug %>"><%= svc.title %></a></h4>
          <div class="svc-price">
            <span class="muted">From</span>
            <strong><%= fmt.bdt(svc.startingPrice || 0) %></strong>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="cta-band grad">
  <div class="container center">
    <h2 class="mt-0">Need something bigger than a package?</h2>
    <p>Custom quotation for multi-vendor marketplaces, ERP integrations and POS-connected stores.</p>
    <a class="btn btn-accent btn-lg" href="/contact">Request a custom quote</a>
  </div>
</section>
