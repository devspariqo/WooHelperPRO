<section class="section section-soft">
  <div class="container">
    <div class="section-head center">
      <p class="section-kicker">Our work</p>
      <h1 class="mt-0">Stores and sites we have shipped</h1>
      <p class="muted">Real Bangladeshi businesses, real numbers where the client allowed us to publish them.</p>
    </div>

    <% if (!items.length) { %>
      <div class="empty-state">
        <div class="empty-icon">▣</div>
        <h3>Portfolio coming soon</h3>
        <p class="muted">We are collecting case studies from recent launches.</p>
      </div>
    <% } else { %>
      <div class="grid grid-3">
        <% items.forEach(function (item) { %>
          <article class="pf-card">
            <div class="pf-thumb">
              <% if (item.imageUrl) { %>
                <img src="<%= item.imageUrl %>" alt="<%= item.title %>" loading="lazy">
              <% } else { %>
                <span class="muted"><%= item.title.charAt(0).toUpperCase() %></span>
              <% } %>
            </div>
            <div class="pf-body">
              <% if (item.category) { %><span class="badge badge-info"><%= item.category %></span><% } %>
              <h3 class="mt-2 mb-1"><%= item.title %></h3>
              <% if (item.titleBn) { %><p class="muted mb-2"><%= item.titleBn %></p><% } %>
              <p class="muted"><%= fmt.truncate(item.description || '', 140) %></p>

              <% if (item.results) { %>
                <p class="pf-result"><strong>Result:</strong> <%= item.results %></p>
              <% } %>

              <% if (item.clientName) { %>
                <p class="muted mb-0"><small>Client: <%= item.clientName %></small></p>
              <% } %>

              <% if (item.liveUrl) { %>
                <div class="form-actions mt-3">
                  <a class="btn btn-outline btn-sm" href="<%= item.liveUrl %>" target="_blank" rel="noopener">
                    Visit live site ↗
                  </a>
                </div>
              <% } %>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>

<section class="cta-band grad">
  <div class="container center">
    <h2 class="mt-0">Want a store like one of these?</h2>
    <p>Tell us which one caught your eye and we will scope the same outcome for your business.</p>
    <a class="btn btn-accent btn-lg" href="/contact">Start a conversation</a>
  </div>
</section>
