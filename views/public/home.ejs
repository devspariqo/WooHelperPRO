<%
  const iconFor = function (name) {
    const map = {
      cart: '⌂', layout: '▤', globe: '⊕', search: '⌕', truck: '⇥', shield: '⛨',
      code: '⌨', megaphone: '◈', chart: '◪', server: '▦', palette: '◐', plug: '⚭',
      book: '▭', phone: '☎', star: '★', bolt: '⚡', wrench: '⚒', box: '▣',
    };
    return map[name] || '◆';
  };
%>

<!-- ==================================================================
     HERO
     ================================================================== -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">

      <div>
        <span class="hero-eyebrow">
          <span class="dot" aria-hidden="true"></span>
          Trusted by <%= fmt.number(stats.customers) %>+ Bangladeshi businesses
        </span>

        <h1>
          Your e-commerce website,<br>
          <span class="grad">built and managed for you</span>
        </h1>

        <p class="hero-lede">
          Pick a package, pay with bKash, Nagad or Rocket, and we build a fast,
          mobile-first online store for your business — with payment gateways,
          courier integration and a dashboard you can actually use.
        </p>

        <div class="hero-cta">
          <a href="/order/checkout" class="btn btn-primary btn-lg"><%= t('Start my website') %></a>
          <a href="/packages" class="btn btn-outline btn-lg">See packages &amp; pricing</a>
        </div>

        <div class="hero-proof">
          <div>
            <strong><%= fmt.number(stats.orders) %>+</strong>
            <span><%= t('Websites delivered') %></span>
          </div>
          <div>
            <strong>7 days</strong>
            <span><%= t('Average go-live') %></span>
          </div>
          <div>
            <strong>0.8s</strong>
            <span><%= t('Average load time') %></span>
          </div>
          <div>
            <strong>24/7</strong>
            <span><%= t('Support in Bangla') %></span>
          </div>
        </div>
      </div>

      <div class="hero-visual">
        <% if (settings.heroImageUrl) { %>
          <%
            /*
             * Square hero image. The frame is forced to 1:1 with object-fit: cover,
             * so a non-square upload is cropped rather than squashing the layout.
             * width/height are set so the browser reserves the space before the
             * image loads -- without them the hero reflows and hurts CLS.
             */
          %>
          <figure class="hero-figure">
            <img src="<%= settings.heroImageUrl %>"
                 alt="<%= settings.heroImageAlt || settings.siteName %>"
                 width="1000" height="1000"
                 loading="eager" fetchpriority="high" decoding="async">
          </figure>
        <% } else { %>
          <div class="browser-mock">
            <div class="browser-bar">
              <i></i><i></i><i></i>
              <span class="browser-url">yourbusiness.com.bd</span>
            </div>
            <div class="browser-body">
              <div class="mock-badge"><%= t('Order placed') %></div>
              <div class="mock-line w-90"></div>
              <div class="mock-line w-70"></div>
              <div class="mock-row">
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
                <div class="mock-tile"></div>
              </div>
              <div class="mock-line w-45"></div>
            </div>
          </div>
        <% } %>

        <div class="float-card">
          <span class="ok-dot" aria-hidden="true">৳</span>
          <span>
            <strong><%= tr('Payment received', 'পেমেন্ট পেয়েছি') %></strong>
            <small>bKash &middot; <%= tr('verified in 4 min', '৪ মিনিটে যাচাই') %></small>
          </span>
        </div>
      </div>

    </div>
  </div>
</section>

