     ================================================================== -->
<section class="section" id="services">
  <div class="container">

    <div class="section-head">
      <span class="section-kicker"><%= t('What we do') %></span>
      <h2><%= t('Everything your online shop needs') %></h2>
      <p>
        From the first design concept to courier integration and monthly maintenance —
        we handle the technical side so you can focus on selling.
      </p>
    </div>

    <div class="grid grid-3">
      <% services.forEach(function (service) { %>
        <article class="svc-card" data-reveal>
          <div class="svc-icon" aria-hidden="true"><%= iconFor(service.icon) %></div>
          <h3><%= service.title %></h3>
          <p><%= service.shortDesc %></p>
          <div class="svc-meta">
            <span class="svc-price">
              <% if (service.basePrice > 0) { %>
                <%= t('From') %> <%= fmt.bdt(service.basePrice) %>
              <% } else { %>
                Custom quote
              <% } %>
              <small><%= service.deliveryDays %> <%= t('days delivery') %></small>
            </span>
            <a href="/services/<%= service.slug %>" class="btn btn-outline btn-sm"><%= t('Details') %></a>
          </div>
        </article>
      <% }); %>
    </div>

    <% if (services.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">◌</div>
        <p>Services will appear here once the admin publishes them.</p>
      </div>
    <% } %>

    <div class="center mt-4">
      <a href="/services" class="btn btn-outline"><%= t('Browse all services') %></a>
    </div>

  </div>
</section>

<!-- ==================================================================
     PACKAGES
     ================================================================== -->
<section class="section section-soft" id="packages">
  <div class="container">

    <div class="section-head center">
      <span class="section-kicker"><%= t('Packages & pricing') %></span>
      <h2><%= t('One-time build, or build + monthly care') %></h2>
      <p>Transparent Taka pricing. No hidden charges. Pay online or by bank transfer.</p>
    </div>

    <div class="grid grid-3" style="align-items:stretch">
      <% packages.forEach(function (pkg) {
           const features = json.parse(pkg.features);
           const excluded = json.parse(pkg.excluded);
      %>
        <article class="pkg-card <%= pkg.isPopular ? 'popular' : '' %>" data-reveal>
          <% if (pkg.isPopular) { %><span class="pkg-ribbon"><%= t('Most popular') %></span><% } %>

          <span class="pkg-tier"><%= C.PACKAGE_TIER[pkg.tier].en %></span>
          <h3><%= pkg.name %></h3>
          <p class="pkg-tagline"><%= pkg.tagline || 'A complete website package for growing online businesses.' %></p>

          <div class="pkg-price">
            <span class="amount"><%= fmt.bdt(pkg.price).replace('৳', '') %></span>
            <span class="cycle"><%= t('BDT one-time') %></span>
          </div>

          <% if (pkg.monthlyPrice > 0) { %>
            <p class="muted" style="font-size:13px;margin:2px 0 10px">
              or <%= fmt.bdt(pkg.monthlyPrice) %>/month with ongoing care
              <% if (pkg.yearlyPrice > 0) { %> &middot; <%= fmt.bdt(pkg.yearlyPrice) %>/year<% } %>
            </p>
          <% } %>

          <% if (pkg.discountPercent > 0) { %>
            <span class="pkg-save"><%= t('Save') %> <%= pkg.discountPercent %>%</span>
          <% } else { %>
            <div style="height:8px"></div>
          <% } %>

          <ul class="pkg-features">
            <% features.slice(0, 9).forEach(function (f) { %>
              <li><%= f %></li>
            <% }); %>
            <% excluded.slice(0, 4).forEach(function (f) { %>
              <li class="excluded"><%= f %></li>
            <% }); %>
          </ul>

          <div class="pkg-footer">
            <a href="/order/checkout?package=<%= pkg.id %>" class="btn <%= pkg.isPopular ? 'btn-primary' : 'btn-outline' %> btn-block">
              <%= t('Order this package') %>
            </a>
            <a href="/packages/<%= pkg.slug %>" class="pkg-note"><%= t('See full feature list') %></a>
          </div>
        </article>
      <% }); %>
    </div>

    <div class="center mt-4">
      <a href="/packages" class="btn btn-outline"><%= t('Compare all packages') %></a>
    </div>

  </div>
</section>

