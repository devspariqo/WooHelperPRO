<!DOCTYPE html>
<html lang="<%= lang === 'bn' ? 'bn' : 'en' %>" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : (title ? title + ' — ' + settings.siteName : settings.siteName) %></title>
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : (settings.metaDescription || '') %>">
  <% if (settings.metaKeywords) { %>
  <meta name="keywords" content="<%= settings.metaKeywords %>">
  <% } %>
  <meta name="robots" content="<%= settings.metaRobots || 'index, follow' %>">
  <% if (settings.googleSiteVerification) { %>
  <meta name="google-site-verification" content="<%= settings.googleSiteVerification %>">
  <% } %>
  <% if (typeof canonical !== 'undefined' && canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= settings.siteName %>">
  <meta property="og:title" content="<%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : title %>">
  <meta property="og:description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : '' %>">
  <%
    // Page-level ogImage wins; fall back to the admin-configured share image.
    const shareImage = (typeof ogImage !== 'undefined' && ogImage) ? ogImage : settings.ogImageUrl;
  %>
  <% if (shareImage) { %><meta property="og:image" content="<%= shareImage %>"><% } %>
  <meta name="twitter:card" content="<%= shareImage ? 'summary_large_image' : 'summary' %>">
  <% if (settings.twitterHandle) { %>
  <meta name="twitter:site" content="@<%= settings.twitterHandle %>">
  <% } %>

  <link rel="icon" type="image/svg+xml" href="<%= settings.faviconUrl || '/images/favicon.svg' %>">
  <%
    // Build the Google Fonts request from the admin's font choices. Families are
    // de-duplicated so choosing the same family for heading and body does not
    // request it twice. Weight list is fixed: the stylesheet uses 400-800.
    const fontFamilies = [...new Set(
      [settings.fontBody, settings.fontHeading, settings.fontBodyBn, settings.fontHeadingBn]
        .map(function (f) { return String(f || '').trim(); })
        .filter(Boolean)
    )];
    const fontQuery = fontFamilies
      .map(function (f) { return 'family=' + encodeURIComponent(f).replace(/%20/g, '+') + ':wght@400;500;600;700;800'; })
      .join('&');
  %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (fontQuery) { %>
  <link href="https://fonts.googleapis.com/css2?<%= fontQuery %>&display=swap" rel="stylesheet">
  <% } %>
  <link rel="stylesheet" href="/css/site.css">

  <% if (typeof structuredData !== 'undefined' && structuredData) { %>
  <script type="application/ld+json"><%- JSON.stringify(structuredData) %></script>
  <% } %>

  <style>
    /*
      Admin-controlled brand tokens. These override the compiled defaults in
      site.css, so changing a colour or font in /admin/settings takes effect on
      the next page load with no rebuild.

      Every value is validated server-side before it reaches the database (hex
      for colours, alphanumerics for font names), but they are emitted with <%- %>
      inside a <style> block, so treat them as trusted only because of that
      validation -- do not add an unvalidated field to this block.
    */
    :root {
      --brand-600: <%= settings.primaryColor %>;
      --brand-500: <%= settings.primaryColor %>;
      --brand-700: <%= settings.primaryColor %>;
      --text: <%= settings.secondaryColor %>;
      --accent-500: <%= settings.accentColor %>;
      --accent-600: <%= settings.accentColor %>;
      --font: '<%= settings.fontBody %>', '<%= settings.fontBodyBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-stack: '<%= settings.fontBody %>', '<%= settings.fontBodyBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-heading: '<%= settings.fontHeading %>', '<%= settings.fontHeadingBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); }
  </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>" data-lang="<%= lang %>">

<%- include('../partials/navbar') %>

<%- include('../partials/flash') %>

<main id="main">
  <%- body %>
</main>

<%- include('../partials/footer') %>

<% if (settings.whatsappNumber) { %>
<a class="whatsapp-float"
   href="https://wa.me/<%= settings.whatsappNumber %>?text=<%= encodeURIComponent('Hello WooHelperPro, I am interested in a website package.') %>"
   target="_blank" rel="noopener noreferrer"
   aria-label="Chat on WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35z"/>
    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15c-1.55 0-3.07-.42-4.4-1.2l-.32-.19-3.26.86.87-3.18-.2-.33a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23s8.23 3.69 8.23 8.23c0 4.54-3.69 8.24-8.23 8.24z" fill-rule="evenodd"/>
  </svg>
  <span>Chat</span>
</a>
<% } %>

<script src="/js/site.js" defer></script>

<% if (settings.googleAnalyticsId) { %>
<%#
  Google Analytics 4, loaded only when an ID is configured. The ID is stripped to
  [A-Za-z0-9-] on save, so it cannot break out of the string literals below.
  Deliberately not loaded in development to keep local page views out of the
  property's reports.
%>
<% if (env === 'production') { %>
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.googleAnalyticsId %>"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', '<%= settings.googleAnalyticsId %>');
</script>
<% } %>
<% } %>
</body>
</html>
