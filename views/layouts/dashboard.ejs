<!DOCTYPE html>
<html lang="en" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <%#
    CSRF token for scripts that POST via fetch (the media picker's upload).
    It must go as an X-CSRF-Token HEADER, not a form field: multer parses the
    multipart body after the csrf middleware runs, so a multipart form's _csrf
    field is not yet parsed when the check happens and looks absent.
  %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= typeof metaTitle !== 'undefined' && metaTitle ? metaTitle : title %></title>
  <link rel="icon" type="image/svg+xml" href="<%= settings.faviconUrl || '/images/favicon.svg' %>">
  <%
    // Same font request as the public layout, so the admin/customer panels follow
    // the typography configured in /admin/settings.
    const fontFamilies = [...new Set(
      [settings.fontBody, settings.fontHeading, settings.fontBodyBn, settings.fontHeadingBn]
        .map(function (f) { return String(f || '').trim(); })
        .filter(Boolean)
    )];
    const fontQuery = fontFamilies
      .map(function (f) { return 'family=' + encodeURIComponent(f).replace(/%20/g, '+') + ':wght@400;500;600;700;800'; })
      .join('&');
  %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% if (fontQuery) { %>
  <link href="https://fonts.googleapis.com/css2?<%= fontQuery %>&display=swap" rel="stylesheet">
  <% } %>
  <link rel="stylesheet" href="/css/site.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    /* Admin-controlled brand tokens -- see layouts/public.ejs for the rationale. */
    :root {
      --brand-base: <%= settings.primaryColor %>;
      --brand-400: color-mix(in srgb, var(--brand-base) 74%, #ffffff);
      --brand-500: var(--brand-base);
    /*
     * The TINT steps (50-300) are a THEME concern and must be scoped: they are
     * pale washes behind dark text in light mode and behind light text in dark
     * mode. Emitted unscoped mixed with #ffffff they would put a near-white block
     * on the near-black dark background -- the same specificity trap as --text.
     */
    :root:not([data-theme="dark"]) {
      --brand-50:  color-mix(in srgb, var(--brand-base) 7%, #ffffff);
      --brand-100: color-mix(in srgb, var(--brand-base) 15%, #ffffff);
      --brand-200: color-mix(in srgb, var(--brand-base) 30%, #ffffff);
      --brand-300: color-mix(in srgb, var(--brand-base) 50%, #ffffff);
    }
    [data-theme="dark"] {
      --brand-50:  color-mix(in srgb, var(--brand-base) 12%, #17141f);
      --brand-100: color-mix(in srgb, var(--brand-base) 20%, #17141f);
      --brand-200: color-mix(in srgb, var(--brand-base) 32%, #17141f);
      --brand-300: color-mix(in srgb, var(--brand-base) 46%, #17141f);
    }
      --brand-600: color-mix(in srgb, var(--brand-base) 88%, #000000);
      --brand-700: color-mix(in srgb, var(--brand-base) 74%, #000000);
      --brand-800: color-mix(in srgb, var(--brand-base) 60%, #000000);
      --brand-900: color-mix(in srgb, var(--brand-base) 48%, #000000);
      --accent-500: <%= settings.accentColor %>;
      --accent-600: <%= helpers.shade(settings.accentColor) %>;
      --font: '<%= settings.fontBody %>', '<%= settings.fontBodyBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-stack: '<%= settings.fontBody %>', '<%= settings.fontBodyBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-heading: '<%= settings.fontHeading %>', '<%= settings.fontHeadingBn %>', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
    /* Scoped to light mode -- see the note in layouts/public.ejs. Unscoped, this
       would override the dark theme's own --text and make the page unreadable. */
    :root:not([data-theme="dark"]) {
      --text: <%= settings.secondaryColor %>;
    }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); }
  </style>
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>" data-panel="<%= panel || 'admin' %>">

<div class="app-shell">

  <%- include('../partials/sidebar') %>

  <div class="app-main">

    <%- include('../partials/topbar') %>

    <div class="app-content">
      <%- include('../partials/flash') %>
      <%- body %>
    </div>

    <footer class="app-footer">
      <span>&copy; <%= new Date().getFullYear() %> <%= settings.siteName %></span>
      <span class="muted">
        <%= panel === 'admin' ? 'Admin panel' : 'Customer account' %>
        &middot; v1.0.0
        &middot; <%= env === 'production' ? 'Production' : 'Development' %>
      </span>
    </footer>

  </div>
</div>

<!-- Mobile sidebar backdrop -->
<div class="sidebar-backdrop" hidden></div>

<script src="/js/site.js" defer></script>
<script src="/js/dashboard.js" defer></script>
<script src="/js/media-picker.js" defer></script>

<%#
  express-ejs-layouts is configured with extractScripts: true, which REMOVES any
  inline <script> from the view body and exposes it as the `script` local. If the
  layout does not re-emit it here, the script is silently discarded -- the page
  looks fine and simply does nothing. Every view with an inline script (the media
  uploader, the settings tabs) depends on this line.
%>
<%- typeof script !== 'undefined' ? script : '' %>
</body>
</html>
