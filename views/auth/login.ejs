<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head center">
      <%- include('../partials/auth-brand') %>
      <h1 class="mt-3 mb-1">Welcome back</h1>
      <p class="muted mb-0">Sign in to track your orders, subscriptions and invoices.</p>
    </div>

    <form method="post" action="/login" class="auth-body" novalidate>
      <%- csrfField %>

      <%#
        The POST handler re-renders this view with a flat `error` string on every
        rejection -- empty fields, unknown email, suspended account, wrong password.
        Without this block the page came back 401 with a blank gap where the reason
        should have been, so a failed sign-in looked like the form was broken.
        Render the message explicitly; the shared flash partial is not included
        here because this card has its own layout.
      %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 5h2v6H9V5zm0 8h2v2H9v-2z"/></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <% if (typeof returnTo !== 'undefined' && returnTo) { %>
        <input type="hidden" name="returnTo" value="<%= returnTo %>">
      <% } %>

      <div class="field">
        <label for="email">Email address <span class="req">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" required
               value="<%= typeof email !== 'undefined' && email ? email : '' %>"
               placeholder="you@example.com">
      </div>

      <div class="field">
        <label for="password">Password <span class="req">*</span></label>
        <input id="password" name="password" type="password" autocomplete="current-password" required
               placeholder="Your password">
        <a class="hint" href="/forgot-password">Forgot your password?</a>
      </div>

      <label class="check-row">
        <input type="checkbox" name="remember" value="1" <%= typeof remember !== 'undefined' && remember ? 'checked' : '' %>>
        <span>Keep me signed in on this device</span>
      </label>

      <div class="form-actions">
        <button class="btn btn-primary btn-block btn-lg" type="submit">Sign in</button>
      </div>
    </form>

    <div class="auth-alt center">
      <p class="mb-0">
        New to <%= settings.siteName || 'WooHelperPro' %>?
        <a href="/register">Create an account</a>
      </p>
    </div>

    <div class="auth-foot center">
      <p class="muted mb-0">
        Having trouble signing in? Call
        <a href="tel:<%= settings.supportPhone || '' %>"><%= settings.supportPhone || 'our support line' %></a>.
      </p>
    </div>
  </div>
</div>
