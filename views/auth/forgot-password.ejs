<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-head center">
      <%- include('../partials/auth-brand') %>
      <h1 class="mt-3 mb-1">Reset your password</h1>
      <p class="muted mb-0">
        Enter the email on your account and our team will help you get back in.
      </p>
    </div>

    <% if (typeof sent !== 'undefined' && sent) { %>
      <div class="card card-body">
        <div class="alert alert-info mb-0">
          <strong>Request received.</strong>
          If an account exists for that address, our support team will contact you shortly with
          reset instructions. For anything urgent, call
          <a href="tel:<%= settings.supportPhone || '' %>"><%= settings.supportPhone || 'support' %></a>.
        </div>
      </div>

      <div class="auth-alt center">
        <p class="mb-0"><a href="/login">Back to sign in</a></p>
      </div>
    <% } else { %>
      <form method="post" action="/forgot-password" class="auth-body" novalidate>
        <%- csrfField %>

        <%#
          Rendered when the submitted address is missing or malformed. The POST
          handler passes this as a flat `error` string; without the block the form
          simply reappeared with no explanation.
        %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9 5h2v6H9V5zm0 8h2v2H9v-2z"/></svg>
            <span><%= error %></span>
          </div>
        <% } %>

        <div class="field">
          <label for="email">Email address <span class="req">*</span></label>
          <input id="email" name="email" type="email" required autocomplete="email"
                 value="<%= typeof email !== 'undefined' && email ? email : '' %>"
                 placeholder="you@example.com">
          <span class="hint">We will never tell anyone whether an address is registered.</span>
        </div>

        <div class="form-actions">
          <button class="btn btn-primary btn-block btn-lg" type="submit">Request password reset</button>
        </div>
      </form>

      <div class="auth-alt center">
        <p class="mb-0">Remembered it? <a href="/login">Back to sign in</a></p>
      </div>
    <% } %>
  </div>
</div>
