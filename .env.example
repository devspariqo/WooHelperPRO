# ============================================================
# WooHelperPro — Environment configuration
# Copy this file to `.env` and adjust values.
# ============================================================

# --- Database (SQLite by default; swap provider in prisma/schema.prisma for MySQL/Postgres) ---
DATABASE_URL="file:./woohelperpro.db"

# --- Server ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME="WooHelperPro"

# --- Sessions ---
# CHANGE THIS IN PRODUCTION. Use a long random string.
SESSION_SECRET="change-me-woohelperpro-super-secret-key-min-32-chars"

# --- Admin bootstrap account (created by the seeder) ---
ADMIN_EMAIL="admin@woohelperpro.com"
ADMIN_PASSWORD="WooHelper@2026"

# --- Bangladesh payment gateways ---
# Sandbox credentials. Replace with live credentials before going live.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX=true

BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_SANDBOX=true

# --- Manual wallet numbers shown on the payment page ---
BKASH_MERCHANT_NUMBER="01700000000"
NAGAD_MERCHANT_NUMBER="01700000000"
ROCKET_MERCHANT_NUMBER="017000000001"

# --- Courier integrations (order delivery / client handover) ---
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# --- SMS / Email notifications ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="WooHelperPro <no-reply@woohelperpro.com>"

BULKSMS_API_KEY=""
BULKSMS_SENDER_ID=""

# --- Uploads ---
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB=5
