generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS, ROLES & PERMISSIONS
// ============================================================

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          String       @default("CUSTOMER")
  status        String @default("ACTIVE")
  avatarUrl     String?
  company       String?
  designation   String?
  district      String?
  address       String?
  emailVerified Boolean    @default(false)
  kycStatus     String  @default("NOT_SUBMITTED")
  adminNotes    String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  orders        Order[]
  subscriptions Subscription[]
  tickets       Ticket[]
  ticketReplies TicketReply[]
  invoices      Invoice[]
  payments      Payment[]
  activityLogs  ActivityLog[]
  notes         ClientNote[]
  projects      Project[]
  staffAssigned Project[]    @relation("ProjectManager")
  mediaAssets   MediaAsset[] @relation("MediaUploader")

  @@index([role])
  @@index([status])
}

model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  detail     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// SERVICES CATALOG  (what the agency sells)
// ============================================================

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  nameBn      String
  slug        String    @unique
  description String?
  icon        String?   @default("layout")
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]
}

model Service {
  id             String        @id @default(cuid())
  title          String
  titleBn        String?
  slug           String        @unique
  categoryId     String?
  shortDesc      String
  shortDescBn    String?
  description    String
  descriptionBn  String?
  icon           String?       @default("layout")
  imageUrl       String?
  basePrice      Float         @default(0)
  features       String        @default("[]") // JSON array
  featuresBn     String        @default("[]") // JSON array
  deliveryDays   Int           @default(7)
  status         String @default("ACTIVE")
  isFeatured     Boolean       @default(false)
  sortOrder      Int           @default(0)
  metaTitle      String?
  metaDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packages Package[]

  @@index([status])
  @@index([categoryId])
}

// ============================================================
// PACKAGES & PLANS (one-time build packages + recurring plans)
// ============================================================

model Package {
  id              String       @id @default(cuid())
  name            String
  nameBn          String?
  slug            String       @unique
  serviceId       String?
  tier            String  @default("BASIC")
  tagline         String?
  taglineBn       String?
  price           Float        @default(0)          // one-time build price (BDT)
  setupFee        Float        @default(0)
  monthlyPrice    Float        @default(0)
  yearlyPrice     Float        @default(0)
  discountPercent Int          @default(0)
  billingCycle    String @default("ONE_TIME")
  features        String       @default("[]")       // JSON array of strings
  featuresBn      String       @default("[]")
  excluded        String       @default("[]")       // JSON array — not-included items
  excludedBn      String       @default("[]")
  revisions       Int          @default(2)
  deliveryDays    Int          @default(7)
  supportMonths   Int          @default(3)
  hostingMonths   Int          @default(0)
  pagesIncluded   Int          @default(5)
  productsLimit   Int          @default(0)          // 0 = unlimited
  staffLimit      Int          @default(1)
  isPopular       Boolean      @default(false)
  isActive        Boolean      @default(true)
  isRecurring     Boolean      @default(false)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  service     Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  orders      Order[]
  subscriptions Subscription[]

  @@index([isActive])
  @@index([serviceId])
}

// ============================================================
// ORDERS  (customer buys a package -> we build a website)
// ============================================================

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  packageId       String?
  serviceId       String?
  projectName     String
  projectType     String?         // e.g. "Ecommerce Website", "Landing Page"
  businessName    String?
  businessType    String?
  websiteGoal     String?
  referenceUrls   String?
  selectedPages   String          @default("[]") // JSON array
  domainName      String?
  hostingChoice   String?
  preferredColors String?
  brandNotes      String?
  contactPerson   String?
  contactPhone    String?
  contactEmail    String?
  district        String?
  billingAddress  String?
  subtotal        Float           @default(0)
  discount        Float           @default(0)
  tax             Float           @default(0)
  total           Float           @default(0)
  paidAmount      Float           @default(0)
  advancePaid     Float           @default(0)
  currency        String          @default("BDT")
  couponCode      String?
  status          String     @default("PENDING")
  paymentStatus   String   @default("UNPAID")
  priority        String          @default("NORMAL")
  assignedTo      String?
  internalNotes   String?
  clientNotes     String?
  dueDate         DateTime?
  deliveredAt     DateTime?
  projectUrl      String?
  adminUrl        String?
  accessNote      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Package?   @relation(fields: [packageId], references: [id], onDelete: SetNull)
  project   Project?
  invoices  Invoice[]
  payments  Payment[]
  milestones ProjectMilestone[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// SUBSCRIPTIONS  (monthly / yearly recurring maintenance plans)
// ============================================================

model Subscription {
  id                 String             @id @default(cuid())
  subscriptionNumber String             @unique
  userId             String
  packageId          String?
  planName           String
  billingCycle       String       @default("MONTHLY")
  amount             Float              @default(0)
  setupFee           Float              @default(0)
  status             String @default("ACTIVE")
  autoRenew          Boolean            @default(true)
  startsAt           DateTime           @default(now())
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  nextInvoiceAt      DateTime?
  gracePeriodDays    Int                @default(7)
  discountPercent    Int                @default(0)
  currency           String             @default("BDT")
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  package  Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  invoices Invoice[]
  addons   SubscriptionAddon[]

  @@index([status])
  @@index([userId])
  @@index([currentPeriodEnd])
}

model SubscriptionAddon {
  id             String   @id @default(cuid())
  subscriptionId String
  name           String
  nameBn         String?
  price          Float    @default(0)
  billingCycle   String @default("MONTHLY")
  quantity       Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ============================================================
// INVOICES & PAYMENTS  (bKash / Nagad / Rocket / SSLCommerz / Bank)
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  userId         String
  orderId        String?
  subscriptionId String?
  title          String
  description    String?
  subtotal       Float         @default(0)
  discount       Float         @default(0)
  tax            Float         @default(0)
  total          Float         @default(0)
  amountPaid     Float         @default(0)
  currency       String        @default("BDT")
  status         String @default("DRAFT")
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  vatNumber      String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([status])
  @@index([userId])
}

model Payment {
  id            String           @id @default(cuid())
  reference     String           @unique
  userId        String
  invoiceId     String?
  orderId       String?
  amount        Float
  currency      String           @default("BDT")
  method        String    @default("MANUAL")
  direction     String @default("INBOUND")
  status        String           @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  transactionId String?
  senderNumber  String?
  gatewayPayload String?
  verifiedById  String?
  verifiedAt    DateTime?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
}

// ============================================================
// PROJECT DELIVERY TRACKING
// ============================================================

model Project {
  id            String        @id @default(cuid())
  orderId       String        @unique
  userId        String
  name          String
  status        String @default("NOT_STARTED")
  progress      Int           @default(0)
  currentStage  String?
  managerId     String?
  stagingUrl    String?
  liveUrl       String?
  repoUrl       String?
  techStack     String?
  kickoffDate   DateTime?
  targetDate    DateTime?
  launchedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager   User?              @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]

  @@index([status])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  orderId     String?
  title       String
  description String?
  isDone      Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// ============================================================
// COUPONS & PROMOTIONS
// ============================================================

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  String @default("PERCENT")
  discountValue Float        @default(0)
  minOrder      Float        @default(0)
  maxUses       Int          @default(0)   // 0 = unlimited
  usedCount     Int          @default(0)
  appliesTo     String       @default("ALL") // ALL | SERVICE | PACKAGE | SUBSCRIPTION
  isActive      Boolean      @default(true)
  startsAt      DateTime     @default(now())
  expiresAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
}

// ============================================================
// SUPPORT TICKETS
// ============================================================

model Ticket {
  id        String       @id @default(cuid())
  ticketNumber String    @unique
  userId    String
  subject   String
  message   String
  category  String       @default("GENERAL")
  priority  String       @default("NORMAL")
  status    String @default("OPEN")
  assignedTo String?
  orderId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  closedAt  DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@index([status])
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String?
  body       String
  isStaff    Boolean  @default(false)
  attachment String?
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ============================================================
// CONTENT: testimonials, portfolio, blog, FAQ, leads
// ============================================================

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  district   String?
  avatarUrl  String?
  rating     Int      @default(5)
  body       String
  bodyBn     String?
  isApproved Boolean  @default(false)
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isApproved])
}

model PortfolioItem {
  id          String   @id @default(cuid())
  title       String
  titleBn     String?
  clientName  String?
  slug        String   @unique
  category    String?
  description String?
  imageUrl    String?
  liveUrl     String?
  results     String?
  techStack   String?
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([isPublished])
}

model BlogPost {
  id              String    @id @default(cuid())
  title           String
  titleBn         String?
  slug            String    @unique
  excerpt         String?
  content         String
  coverImage      String?
  category        String?
  tags            String    @default("[]")
  authorId        String?
  status          String    @default("DRAFT") // DRAFT | PUBLISHED
  isFeatured      Boolean   @default(false)
  views           Int       @default(0)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  questionBn String?
  answer    String
  answerBn  String?
  category  String   @default("GENERAL")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String
  company     String?
  district    String?
  serviceType String?
  budget      String?
  message     String?
  source      String   @default("WEBSITE")
  status      String   @default("NEW") // NEW | CONTACTED | QUALIFIED | CONVERTED | LOST
  assignedTo  String?
  followUpAt  DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([status])
}

// ============================================================
// SITE SETTINGS (single-row config the admin can edit)
// ============================================================

model SiteSetting {
  id              String   @id @default("singleton")
  siteName        String   @default("WooHelperPro")
  tagline         String   @default("")
  taglineBn       String   @default("")
  supportEmail    String   @default("support@woohelperpro.com")
  supportPhone    String   @default("+8801700000000")
  whatsappNumber  String   @default("8801700000000")
  officeAddress   String   @default("")
  bkashNumber     String   @default("")
  nagadNumber     String   @default("")
  rocketNumber    String   @default("")
  bankDetails     String   @default("")
  vatPercent      Float    @default(5)
  currency        String   @default("BDT")
  maintenanceMode Boolean  @default(false)
  metaTitle       String   @default("")
  metaDescription String   @default("")
  facebookUrl     String   @default("")
  youtubeUrl      String   @default("")
  linkedinUrl     String   @default("")
  updatedAt       DateTime @updatedAt

  // ---- Branding: logo & favicon -------------------------------------------
  // A URL rather than an upload: the project ships no upload middleware, so an
  // admin pastes a path (e.g. /images/logo.svg) or an absolute CDN URL. The
  // layouts fall back to the text wordmark when this is blank.
  logoUrl         String   @default("")
  logoAlt         String   @default("")
  logoHeightPx    Int      @default(32)
  faviconUrl      String   @default("")

  // ---- Branding: colours --------------------------------------------------
  // Hex strings, injected as CSS custom properties by the layouts. The defaults
  // mirror the palette already compiled into public/css/site.css (--brand-600,
  // --text, --accent-500) so a fresh install looks identical to the theme.
  primaryColor    String   @default("#7c3aed")
  secondaryColor  String   @default("#17141f")
  accentColor     String   @default("#ff6600")

  // ---- Typography ---------------------------------------------------------
  // Google Fonts family names. The layout builds the <link> from these, so
  // changing the value here changes the font on every page without a rebuild.
  fontHeading     String   @default("Inter")
  fontBody        String   @default("Inter")
  fontHeadingBn   String   @default("Hind Siliguri")
  fontBodyBn      String   @default("Hind Siliguri")

  // ---- SEO ----------------------------------------------------------------
  metaKeywords          String @default("")
  metaRobots            String @default("index, follow")
  ogImageUrl            String @default("")
  googleAnalyticsId     String @default("")
  googleSiteVerification String @default("")
  twitterHandle         String @default("")

  // ---- General ------------------------------------------------------------
  timezone        String   @default("Asia/Dhaka")
  defaultLanguage String   @default("en")
  dateFormat      String   @default("DD MMM YYYY")
  footerText      String   @default("")

  // ---- Payment method logos ------------------------------------------------
  // URLs into the media library. Rendered on the checkout, package pages and the
  // public footer so a customer can see which rails are accepted before paying.
  // Blank means the method is simply not advertised -- nothing renders.
  bkashLogoUrl      String @default("")
  nagadLogoUrl      String @default("")
  rocketLogoUrl     String @default("")
  sslcommerzLogoUrl String @default("")
  bankLogoUrl       String @default("")
  codLogoUrl        String @default("")
  cardLogoUrl       String @default("")

  // ---- Outbound mail ------------------------------------------------------
  // SMTP is admin-editable so the operator can change provider without a
  // redeploy. Falls back to the SMTP_* env vars when these are blank.
  smtpHost        String  @default("")
  smtpPort        Int     @default(587)
  smtpSecure      Boolean @default(false)
  smtpUser        String  @default("")
  smtpPassword    String  @default("")
  mailFromName    String  @default("")
  mailFromEmail   String  @default("")

  // Where admin alerts go. Blank falls back to supportEmail, then to env.
  adminNotificationEmail String @default("")

  // Per-event switches. Both directions, so an operator can silence one without
  // disabling mail entirely.
  notifyAdminOnOrder   Boolean @default(true)
  notifyAdminOnPayment Boolean @default(true)
  notifyAdminOnTicket  Boolean @default(true)
  notifyAdminOnLead    Boolean @default(true)
  notifyCustomerOnOrder   Boolean @default(true)
  notifyCustomerOnPayment Boolean @default(true)

  // ---- Crawling -----------------------------------------------------------
  sitemapEnabled       Boolean @default(true)
  robotsTxt            String  @default("")
  robotsExtraDisallow  String  @default("")
}

// ============================================================
// MEDIA LIBRARY
// ============================================================
//
// One row per uploaded file. The bytes live on disk under UPLOAD_DIR and this
// records what they are, so the admin can browse, reuse and delete them, and so
// orphaned files can be found later.
//
// `url` is what templates render; it is stored rather than derived so that
// moving to object storage later is a data change, not a code change.

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String                        // name on disk, unique
  originalName String                        // what the user's file was called
  url          String                        // public path, e.g. /uploads/abc.png
  mimeType     String
  sizeBytes    Int
  width        Int?                          // null for non-images / undetected
  height       Int?
  altText      String   @default("")
  folder       String   @default("general")  // logical grouping: general, payments, blog, portfolio
  uploadedById String?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
}
